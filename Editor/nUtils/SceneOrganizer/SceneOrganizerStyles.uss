/* Scene Organizer. Colours come from the editor theme's --unity-colors-* variables so
   the window tracks the user's skin instead of carrying its own palette. */

.so-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

/* ------------------------------------------------------------------- toolbar */

.so-search {
    width: 220px;
    margin-left: 4px;
}

.so-toolbar-spacer {
    flex-grow: 1;
}

/* --------------------------------------------------------------------- panes */

.so-pane {
    flex-grow: 1;
    min-width: 180px;
}

.so-pane__header {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 4px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.so-pane__title {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.so-pane__count {
    margin-left: 6px;
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    flex-grow: 1;
}

.so-pane__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------------------------------------------------------------- scene rows */

.so-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 6px;
    padding-right: 6px;
}

.so-row__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 5px;
}

.so-row__name {
    font-size: 12px;
    color: var(--unity-colors-default-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.so-row__note {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 5px;
    opacity: 0.8;
}

.so-row__spacer {
    flex-grow: 1;
    min-width: 4px;
}

.so-row__path {
    flex-shrink: 1;
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
}

/* Recents get a tint so they read as a different section at a glance; the theme's link
   colour keeps it readable on the light skin as well as the dark one. */
.so-row--recent .so-row__name {
    color: var(--unity-colors-link-text);
}

/* A scene open in the editor right now: bold, with an accent bar on its left edge. */
.so-row--open {
    border-left-width: 2px;
    border-left-color: var(--unity-colors-highlight-background);
    padding-left: 4px;
}

.so-row--open .so-row__name {
    -unity-font-style: bold;
}

/* A grouped scene that isn't in the project any more (kept until removed by hand). */
.so-row--missing {
    opacity: 0.5;
}

.so-row--missing .so-row__name {
    -unity-font-style: italic;
}

.unity-collection-view__item--selected .so-row__name,
.unity-collection-view__item--selected .so-row__path {
    color: var(--unity-colors-highlight-text);
}

/* -------------------------------------------------------------- recent block */

.so-recent {
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
    padding-bottom: 2px;
}

.so-recent > .unity-foldout__toggle {
    margin-left: 4px;
}

.so-recent .unity-foldout__text {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--unity-colors-input_field_placeholder-text);
}

.so-recent .unity-foldout__content {
    margin-left: 0;
}

/* --------------------------------------------------------------- group cards */

.so-groups {
    flex-grow: 1;
    padding-top: 4px;
    padding-bottom: 8px;
}

.so-group {
    flex-direction: row;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--unity-colors-default-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    transition-property: background-color;
    transition-duration: 110ms;
    transition-timing-function: ease-out;
}

/* Drop target while dragging scenes in from the left pane. */
.so-group--drop {
    background-color: var(--unity-colors-highlight-background);
}

.so-group__stripe {
    width: 4px;
    flex-shrink: 0;
}

.so-group__main {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.so-group__header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    flex-shrink: 0;
    padding-left: 2px;
    padding-right: 4px;
}

.so-group__foldout > .unity-foldout__content {
    display: none;
}

.so-group__foldout > .unity-foldout__toggle {
    margin-left: 0;
    margin-right: 0;
}

.so-group__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.so-group__rename {
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
}

.so-group__count {
    margin-left: 6px;
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    flex-shrink: 0;
}

.so-group__spacer {
    flex-grow: 1;
    min-width: 4px;
}

.so-group__scenes {
    flex-shrink: 0;
}

.so-group__empty {
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    -unity-text-align: middle-center;
    height: 26px;
    margin-left: 6px;
}

/* ------------------------------------------------------------------- buttons */

.so-btn {
    height: 20px;
    margin-left: 3px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 3px;
    font-size: 11px;
    flex-shrink: 0;
}

.so-btn--icon {
    width: 22px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

/* An editor icon inside an icon button (the group menu). */
.so-btn__glyph {
    width: 14px;
    height: 14px;
}

.so-swatch {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 2px;
    border-radius: 3px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.35);
    border-right-color: rgba(0, 0, 0, 0.35);
    border-top-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

/* -------------------------------------------------------------- empty states */

.so-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 16px;
    padding-right: 16px;
}

.so-empty__title {
    font-size: 12px;
    color: var(--unity-colors-label-text);
    -unity-text-align: middle-center;
}

.so-empty__hint {
    margin-top: 5px;
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    -unity-text-align: middle-center;
    white-space: normal;
}

.so-empty__action {
    margin-top: 12px;
    height: 24px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 3px;
}

/* ------------------------------------------------------------- colour picker */

.so-swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.so-swatch-grid__item {
    width: 46px;
    height: 46px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.so-swatch-grid__item--selected {
    border-left-color: var(--unity-colors-default-text);
    border-right-color: var(--unity-colors-default-text);
    border-top-color: var(--unity-colors-default-text);
    border-bottom-color: var(--unity-colors-default-text);
}

/* -------------------------------------------------------- create scene dialog */

.so-dialog {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 10px;
}

.so-section-title {
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--unity-colors-input_field_placeholder-text);
    margin-left: 3px;
    margin-bottom: 4px;
}

.so-templates {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.so-template {
    width: 112px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-radius: 5px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-default-background);
    transition-property: border-color, background-color;
    transition-duration: 90ms;
}

.so-template:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.so-template--selected {
    border-left-color: var(--unity-colors-highlight-background);
    border-right-color: var(--unity-colors-highlight-background);
    border-top-color: var(--unity-colors-highlight-background);
    border-bottom-color: var(--unity-colors-highlight-background);
    background-color: var(--unity-colors-highlight-background-inactive);
}

.so-template__thumb {
    height: 66px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.18);
}

/* Unity's own setups show the scene icon small in the middle rather than a picture. */
.so-template--builtin .so-template__thumb {
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.so-template__title {
    margin-top: 5px;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--unity-colors-default-text);
}

.so-template--selected .so-template__title {
    -unity-font-style: bold;
}

.so-form-field {
    margin-bottom: 4px;
}

.so-form-field > .unity-base-field__label {
    min-width: 110px;
}

.so-form-row {
    flex-direction: row;
    align-items: center;
}

.so-form-row__grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.so-form-row .so-btn {
    margin-bottom: 4px;
}

.so-result {
    margin-top: 8px;
    margin-left: 3px;
    font-size: 11px;
    white-space: normal;
    color: var(--unity-colors-input_field_placeholder-text);
}

.so-result--warn {
    color: rgb(230, 175, 60);
}

.so-result--error {
    color: rgb(235, 100, 90);
}

.so-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.so-dialog__button {
    min-width: 84px;
    height: 24px;
    margin-left: 6px;
}

.so-dialog__button--primary {
    -unity-font-style: bold;
}
