/* nSearch - spotlight-style launcher, dressed in Unity's own editor theme.
   Colours come from the --unity-colors-* variables the default theme defines, so the
   window tracks whatever skin the editor is on without a hand-written light palette.
   (The window itself is an OS rectangle and USS has no box-shadow, so the floating
   rounded card look is out of reach; everything inside it is not.) */

.nsearch-root {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--unity-colors-window-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-window-border);
    border-right-color: var(--unity-colors-window-border);
    border-top-color: var(--unity-colors-window-border);
    border-bottom-color: var(--unity-colors-window-border);
}

/* ---------------------------------------------------------------- search row */

.nsearch-search-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 10px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.nsearch-search-icon {
    width: 16px;
    height: 16px;
    margin-right: 9px;
    opacity: 0.55;
    flex-shrink: 0;
}

.nsearch-field {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* Strip the default field chrome so the bar reads as one surface. */
.nsearch-field > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    font-size: 15px;
    color: var(--unity-colors-default-text);
    -unity-text-align: middle-left;
}

.nsearch-field > .unity-base-field__input:focus {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.nsearch-clear {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 6px;
    border-radius: 8px;
    background-color: var(--unity-colors-helpbox-background);
    color: var(--unity-colors-helpbox-text);
    font-size: 10px;
    -unity-text-align: middle-center;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: background-color;
    transition-duration: 100ms;
    transition-timing-function: ease-out;
}

.nsearch-clear:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

/* ------------------------------------------------------------------- results */

.nsearch-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-top: 3px;
    padding-bottom: 3px;
}

.nsearch-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.nsearch-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.nsearch-row--selected {
    background-color: var(--unity-colors-highlight-background);
}

.nsearch-row__icon {
    width: 20px;
    height: 20px;
    margin-right: 9px;
    flex-shrink: 0;
}

.nsearch-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    justify-content: center;
}

.nsearch-row__name {
    font-size: 12px;
    color: var(--unity-colors-default-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nsearch-row__path {
    font-size: 10px;
    color: var(--unity-colors-input_field_placeholder-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nsearch-row--selected .nsearch-row__name {
    color: var(--unity-colors-highlight-text);
}

.nsearch-row--selected .nsearch-row__path {
    color: var(--unity-colors-highlight-text);
    opacity: 0.7;
}

.nsearch-row__badge {
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 2px;
    background-color: var(--unity-colors-helpbox-background);
    color: var(--unity-colors-input_field_placeholder-text);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.nsearch-row--selected .nsearch-row__badge {
    color: var(--unity-colors-highlight-text);
    opacity: 0.85;
}

/* --------------------------------------------------------------- empty state */

.nsearch-empty {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
}

.nsearch-empty__title {
    font-size: 12px;
    color: var(--unity-colors-label-text);
}

.nsearch-empty__hint {
    font-size: 10px;
    color: var(--unity-colors-input_field_placeholder-text);
    margin-top: 3px;
}

/* -------------------------------------------------------------------- footer */

.nsearch-footer {
    flex-direction: row;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 8px;
    background-color: var(--unity-colors-toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-toolbar-border);
}

.nsearch-footer__count {
    font-size: 10px;
    color: var(--unity-colors-input_field_placeholder-text);
    flex-grow: 1;
}

.nsearch-hints {
    flex-direction: row;
    align-items: center;
}

.nsearch-hint {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.nsearch-hint__key {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 2px;
    background-color: var(--unity-colors-helpbox-background);
    color: var(--unity-colors-label-text);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.nsearch-hint__label {
    margin-left: 4px;
    font-size: 10px;
    color: var(--unity-colors-input_field_placeholder-text);
}

/* ------------------------------------------------------------------ settings */

.nsearch-settings {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 6px;
}

.nsearch-settings__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    margin-bottom: 6px;
}

.nsearch-settings__section {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    margin-top: 8px;
    margin-bottom: 4px;
}

.nsearch-settings__rule {
    height: 1px;
    background-color: var(--unity-colors-toolbar-border);
    margin-top: 8px;
    margin-bottom: 4px;
}

/* Content is measured to size the window, so it must not stretch to fill it. */
.nsearch-settings__content {
    flex-shrink: 0;
}

.nsearch-settings .unity-base-field__label {
    color: var(--unity-colors-label-text);
    font-size: 11px;
    min-width: 150px;
}

/* Tab walks these controls now, so keyboard focus has to be obvious. */
.nsearch-settings .unity-base-field:focus,
.nsearch-settings .unity-base-field__input:focus {
    background-color: var(--unity-colors-highlight-background-hover);
    border-radius: 3px;
}

.nsearch-rebuild:focus {
    border-left-color: var(--unity-colors-input_field-border-focus);
    border-right-color: var(--unity-colors-input_field-border-focus);
    border-top-color: var(--unity-colors-input_field-border-focus);
    border-bottom-color: var(--unity-colors-input_field-border-focus);
}

.nsearch-help-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.nsearch-help-row__prefix {
    width: 72px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
}

.nsearch-help-row__desc {
    font-size: 10px;
    color: var(--unity-colors-input_field_placeholder-text);
}

.nsearch-status {
    font-size: 10px;
    margin-top: 6px;
}

.nsearch-rebuild {
    height: 22px;
    border-radius: 3px;
    margin-left: 0;
    margin-right: 0;
}
